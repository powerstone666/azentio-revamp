<h1 style="margin: 0 0 {{#if subtitle}}12px{{else}}24px{{/if}} 0; font-family: {{{brand.fontStack}}}; font-size: 26px; line-height: 34px; font-weight: 600; color: {{brand.navy}};">
  <span style="border-bottom: 3px solid {{brand.mint}}; padding-bottom: 4px;">{{title}}</span>
</h1>
{{#if subtitle}}
<p style="margin: 0 0 24px 0; font-size: 16px; line-height: 26px; color: {{brand.muted}};">{{subtitle}}</p>
{{/if}}
{{#each paragraphs}}
<p style="margin: 0 0 18px 0; font-size: 16px; line-height: 26px; color: {{../brand.text}}; white-space: pre-line;">{{this}}</p>
{{/each}}
{{#if callout}}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 6px 0 24px 0;">
  <tr>
    <td style="background-color: {{brand.mintTint}}; border-radius: {{brand.radius}}; padding: 16px 20px; font-size: 14px; line-height: 22px; color: {{brand.navy}};">{{callout}}</td>
  </tr>
</table>
{{/if}}
{{#if actionUrl}}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin-top: 8px;">
  <tr>
    <td align="center" bgcolor="{{brand.mint}}" style="border-radius: 50px; background-color: {{brand.mint}};">
      <a href="{{actionUrl}}" target="_blank" style="display: inline-block; padding: 14px 34px; font-family: {{{brand.fontStack}}}; font-size: 15px; font-weight: 600; color: {{brand.navy}}; text-decoration: none; border-radius: 50px;">{{#if actionLabel}}{{actionLabel}}{{else}}Open{{/if}}</a>
    </td>
  </tr>
</table>
{{/if}}
